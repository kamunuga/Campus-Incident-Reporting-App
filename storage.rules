rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
             .matches('.*@(alustudent|alueducation)[.]com$');
    }

    function isStaff() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function isReporter(incidentId) {
      return firestore.get(
        /databases/(default)/documents/incidents/$(incidentId)).data.reporterId
          == request.auth.uid;
    }

    match /incidents/{incidentId}/{fileName} {
      allow read: if verified();

      allow create: if verified()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if verified()
        && (isStaff() || isReporter(incidentId));

      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
